# Copy to .env and adjust. Every value is optional in development.
DEBUG=True
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1
# CSRF_TRUSTED_ORIGINS=https://family.example.com

# Leave DATABASE_URL unset to use SQLite. For production use PostgreSQL:
# DATABASE_URL=postgres://family:password@localhost:5432/githinji_family
# Keep the SQLite file outside Google Drive/OneDrive to avoid sync locking issues:
# SQLITE_PATH=C:/Users/you/family-data/db.sqlite3

# MEDIA_ROOT=C:/Users/you/family-data/media
# SERVE_MEDIA=False
SITE_NAME=Githinji Family
TIME_ZONE=Africa/Nairobi
